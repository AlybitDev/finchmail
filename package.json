{
  "name": "finchmail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "cd .next/standalone && node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker": "prisma generate && tsx scripts/sync-worker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "imapflow": "^2.5.9",
    "mailparser": "^3.10.0",
    "next": "^15.3.0",
    "dotenv": "^16.6.1",
    "nodemailer": "^10.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.56.1"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "deepmerge-ts": "^8.0.2"
  }
}
