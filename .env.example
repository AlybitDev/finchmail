# Copy to .env before running with Docker Compose.
POSTGRES_DB=finchmail
POSTGRES_USER=finchmail
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://finchmail:replace-with-a-long-random-password@db:5432/finchmail

# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace-with-64-hex-characters

# One-time gate to prevent someone else claiming the owner account at first launch.
# Generate with: openssl rand -base64 36
INITIAL_SETUP_TOKEN=replace-with-a-long-random-one-time-token

# Optional: allow custom mail hosts that resolve to private LAN/VPN IP addresses.
# Enable only when you intentionally connect to a trusted private mail server.
ALLOW_PRIVATE_MAIL_HOSTS=false

# Optional cookie domain. Leave unset for host-only cookies; set only when serving
# Finchmail on an explicit domain such as mail.example.com.
# SESSION_COOKIE_DOMAIN=mail.example.com

# Optional Argon2id memory cost in KiB (minimum 19456; default 19456).
# Increase to 65536 or higher on a capable server.
# ARGON2_MEMORY_COST=19456
